{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hsn-autoreply",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // The service's domains (Cloudflare zones hsnreply.online and shayyek.sa). workers.dev stays available too.
  "routes": [
    { "pattern": "hsnreply.online", "custom_domain": true },
    { "pattern": "www.hsnreply.online", "custom_domain": true },
    { "pattern": "shayyek.sa", "custom_domain": true },
    { "pattern": "www.shayyek.sa", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Static PWA assets built by Vite. The Worker handles only the listed paths first.
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/l/*", "/m/*", "/c/*", "/webhooks/*", "/oauth/*", "/meta/*", "/privacy", "/terms", "/refund", "/data-deletion", "/pricing", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hsn_autoreply",
      // Replace with the id printed by `wrangler d1 create hsn_autoreply` (see docs/DEPLOY.md)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Media for scheduled publishing (private bucket; files are served to Meta through short-lived signed links
  // on /m/* and deleted after the post is published).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "hsn-media" }],
  "triggers": {
    // every minute: durable job queue; daily 03:17 UTC: token refresh + retention cleanup
    "crons": ["* * * * *", "17 3 * * *"]
  },
  "vars": {
    "INSTAGRAM_APP_ID": "",
    "META_API_VERSION": "v26.0",
    "META_API_VERIFIED_AT": "2026-09-25",
    "PUBLIC_BASE_URL": "https://hsn-autoreply.YOUR-SUBDOMAIN.workers.dev",
    // The service's own domain (expiry date shown on the owner's usage page).
    "SERVICE_DOMAIN": "hsnreply.online",
    // Sender of password-recovery emails (the domain is verified in Resend).
    "EMAIL_FROM": "شيّك Shayyek <no-reply@shayyek.sa>",
    "EMAIL_FROM_FALLBACK": "شيّك Shayyek <no-reply@hsnreply.online>",
    "ALLOWED_APP_ORIGINS": "https://localhost,capacitor://localhost",
    "APP_VERSION": "1.0.0",
    "APP_DEEP_LINK": "sa.shayyek.app://oauth-done",
    "RELEASES_URL": "https://github.com/hassanbinageel-wq/shayyek/releases",
    "APK_DOWNLOAD_URL": ""
  }
}
