{
  "name": "hsn-autoreply",
  "private": true,
  "version": "1.1.3",
  "description": "HSN AutoReply — Instagram automation via the official Meta Instagram API",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:worker": "wrangler dev",
    "build:web": "vite build",
    "build:app": "vite build --mode capacitor && cap sync android",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply hsn_autoreply --local",
    "db:migrate:remote": "wrangler d1 migrations apply hsn_autoreply --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260925.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "~4.1.0",
    "wrangler": "4.141.0"
  }
}
